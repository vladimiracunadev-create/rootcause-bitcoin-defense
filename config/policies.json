{
  "version": 1,
  "highValueThresholdSats": 10000000,
  "requireIndependentVendorsForHighValue": true,
  "minimumHighValueQuorum": {
    "required": 2,
    "total": 3
  },
  "blockUnknownFirmware": true,
  "blockAffectedWalletDeposits": true,
