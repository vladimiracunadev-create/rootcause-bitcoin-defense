  "humanApprovalRequired": [
    "create_migration_psbt",
    "change_wallet_descriptor",
    "broadcast_transaction",
    "rotate_signers"
  ],
  "forbiddenActions": [
    "collect_seed_words",
    "collect_private_keys",
    "collect_bip39_passphrases",
    "sign_on_application_server",
    "auto_broadcast_recovery_transaction"
  ]
}
