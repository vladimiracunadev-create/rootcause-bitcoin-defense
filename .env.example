# The application binds only to localhost by default.
HOST=127.0.0.1
PORT=8787
DEMO_MODE=true

# Required for encrypted persistence when DEMO_MODE=false.
# Generate with: pnpm generate:data-key
ROOTCAUSE_DATA_KEY=
DATA_DIR=./data

# Optional read-only Bitcoin Core connection.
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_RPC_COOKIE_FILE=
ALLOW_REMOTE_RPC=false
BITCOIN_RPC_TIMEOUT_MS=5000

# Polling is disabled unless explicitly enabled.
WATCHTOWER_ENABLED=false
WATCHTOWER_INTERVAL_MS=15000

# Security controls.
REQUEST_BODY_LIMIT_BYTES=65536
RATE_LIMIT_PER_MINUTE=120
HIGH_VALUE_THRESHOLD_SATS=10000000
