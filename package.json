{
  "name": "rootcause-bitcoin-defense",
  "version": "0.3.0",
  "private": true,
  "description": "Watch-only Bitcoin defense, causal analysis and incident response desktop app for RootCause.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "lint": "node scripts/validate-repo.js",
    "check:local-only": "node scripts/check-local-only.js",
    "check:security": "node scripts/check-security-claims.js",
    "check:docs": "node scripts/check-docs.js",
    "check:secrets": "node scripts/check-history-secrets.js",
    "check:runtime": "node scripts/check-runtime-advisories.js",
    "check:style": "node scripts/check-doc-style.js",
    "check:rules": "node scripts/generate-rule-docs.js --check",
    "check": "node scripts/validate-repo.js && node scripts/check-local-only.js && node scripts/check-docs.js && node scripts/check-doc-style.js && node scripts/generate-rule-docs.js --check && node --test && node scripts/check-security-claims.js",
    "generate:data-key": "node scripts/generate-key.js",
    "seed:demo": "node scripts/seed-demo.js",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/windows/make-icon.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File packaging/windows/build-portable.ps1",
    "audit:bitcoin": "node scripts/audit-bitcoin.js",
    "audit:bitcoin:report": "node scripts/audit-bitcoin.js --report",
    "forensics:demo": "node scripts/analyze-bitcoin-scenario.js",
    "lab:regtest": "node scripts/run-regtest-lab.js",
    "plugin:sync": "node scripts/sync-plugin.js",
    "docs:rules": "node scripts/generate-rule-docs.js"
  },
  "keywords": [
    "bitcoin",
    "security",
    "root-cause-analysis",
    "watch-only",
    "incident-response",
    "wallet-security",
    "windows",
    "desktop-app",
    "local-first",
    "bitcoin-core",
    "zero-dependencies"
  ],
  "license": "MIT"
}
